# Database
# For local dev: sqlite is default (no setup). For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/inboxops
DATABASE_URL=sqlite:///./inboxops.db

# LLM - Gemini 3.6 Flash
# Get keys from https://aistudio.google.com/app/apikey
# Provide comma-separated: GEMINI_API_KEYS=key1,key2
# If left empty, the service runs in deterministic MOCK mode (good for tests/offline)
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Example with 2 keys: GEMINI_API_KEYS=AIza...,AIza...
# Alias accepted: LLM_API_KEY / LLM_API_KEYS / GOOGLE_API_KEY
GEMINI_MODEL=gemini-3.6-flash
LLM_MODEL=gemini-3.6-flash

# Deterministic rules
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=3
MAX_INPUT_LENGTH=2000
MAX_OUTPUT_TOKENS=800
RATE_LIMIT_RPM=5
RATE_LIMIT_RPD=20
CACHE_TTL_SECONDS=86400

# App
ENV=development
APP_VERSION=0.1.0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo auth (production would use RBAC / OAuth / Secret Manager)
DEMO_ACTOR_ID=demo_user
